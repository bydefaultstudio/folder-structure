{
  // Cloudflare Workers static-assets config. CI (Workers Builds, connected
  // to the GitHub repo) runs `npm install && npm run build` then
  // `npx wrangler deploy`; `npm run deploy` does the same from a machine.
  "name": "folder-structure",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist"
  }
}
